    "@strapi/design-system": "2.2.1",
    "@strapi/icons": "2.2.1",
    "@strapi/plugin-cloud": "5.50.0",
    "@strapi/plugin-seo": "^2.0.4",
    "@strapi/plugin-users-permissions": "5.50.0",
    "@strapi/strapi": "5.50.0",
    "better-sqlite3": "11.7.0",
    "pluralize": "^8.0.0",
