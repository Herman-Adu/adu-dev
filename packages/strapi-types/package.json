{
  "name": "@repo/strapi-types",
  "version": "0.0.0",
  "private": true,
  "description": "Mirror of Strapi's generated content-type definitions, shared with the frontend",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    },
    "./generated/components": {
      "types": "./generated/components.d.ts"
    },
    "./generated/contentTypes": {
      "types": "./generated/contentTypes.d.ts"
    }
  },
  "scripts": {
    "build": "echo 'types-only package, nothing to build'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@strapi/strapi": "5.50.0",
    "typescript": "^5"
  }
}
