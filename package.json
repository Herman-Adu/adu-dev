{
  "name": "adu-dev",
  "version": "1.0.0",
  "description": "Strapi + Next.js monorepo template",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "setup:next": "tsx ./scripts/copy-env.mts ./apps/next",
    "setup:strapi": "tsx ./scripts/copy-env.mts ./apps/strapi",
    "setup": "pnpm install && pnpm setup:next && pnpm setup:strapi",
    "dev": "pnpm exec concurrently \"pnpm --filter strapi develop\" \"pnpm exec wait-on http://localhost:1337 && pnpm --filter nextjs dev\"",
    "test": "pnpm test:strapi && pnpm test:next",
    "test:next": "pnpm --filter nextjs test:run",
    "test:strapi": "pnpm --filter strapi test:run",
    "typecheck": "pnpm typecheck:strapi && pnpm typecheck:next",
    "typecheck:next": "pnpm --filter nextjs typecheck",
    "typecheck:strapi": "pnpm --filter strapi typecheck",
    "seed": "pnpm --filter strapi exec strapi import -f ./data/export_20250116105447.tar.gz --force",
    "export": "pnpm --filter strapi exec strapi export --no-encrypt -f ./data/export_20250116105447",
    "check:format": "prettier . --check --cache",
    "fix:format": "prettier . --write --cache",
    "fix": "pnpm fix:format",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.5.2",
    "concurrently": "^8.2.2",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.5.3",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "uuid": "^13.0.0",
    "wait-on": "^8.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write --cache"
    ]
  },
  "packageManager": "pnpm@10.28.1"
}
