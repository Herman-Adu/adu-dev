{
  "name": "adu-dev",
  "version": "1.0.0",
  "description": "Strapi + Next.js monorepo template",
  "private": true,
  "type": "module",
  "workspaces": [
    "next",
    "strapi"
  ],
  "scripts": {
    "prepare": "husky",
    "setup:next": "node --loader ts-node/esm ./scripts/copy-env.mts ./next",
    "setup:strapi": "node --loader ts-node/esm ./scripts/copy-env.mts ./strapi",
    "setup": "yarn install && yarn setup:next && yarn setup:strapi",
    "dev": "yarn concurrently \"yarn workspace strapi develop\" \"yarn wait-on http://localhost:1337 && yarn workspace nextjs dev\"",
    "test": "yarn test:strapi && yarn test:next",
    "test:next": "yarn workspace nextjs test:run",
    "test:strapi": "yarn workspace strapi test:run",
    "seed": "yarn workspace strapi strapi import -f ./data/export_20250116105447.tar.gz --force",
    "export": "yarn workspace strapi strapi export --no-encrypt -f ./data/export_20250116105447",
    "check:format": "prettier . --check --cache",
    "fix:format": "prettier . --write --cache",
    "fix": "yarn fix:format",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@types/node": "^22.5.2",
    "concurrently": "^8.2.2",
    "typescript": "^5.0.0",
    "wait-on": "^8.0.1"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "uuid": "^13.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write --cache"
    ]
  },
  "packageManager": "yarn@4.5.0"
}
