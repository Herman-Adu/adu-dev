{
  "name": "adu-dev",
  "version": "1.0.0",
  "description": "Strapi + Next.js monorepo template",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "setup:next": "tsx ./scripts/copy-env.mts ./apps/next",
    "setup:strapi": "tsx ./scripts/copy-env.mts ./apps/strapi",
    "setup": "pnpm install && pnpm setup:next && pnpm setup:strapi",
    "dev": "pnpm exec concurrently \"pnpm --filter strapi develop\" \"pnpm exec wait-on http://localhost:1337 && pnpm --filter nextjs dev\"",
    "build": "turbo run build",
    "build:next": "turbo run build --filter=nextjs",
    "build:strapi": "turbo run build --filter=strapi",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:next": "turbo run test --filter=nextjs",
    "test:strapi": "turbo run test --filter=strapi",
    "typecheck": "turbo run typecheck",
    "typecheck:next": "turbo run typecheck --filter=nextjs",
    "typecheck:strapi": "turbo run typecheck --filter=strapi",
    "sync:types": "tsx ./scripts/sync-strapi-types.mts",
    "check:types-drift": "tsx ./scripts/sync-strapi-types.mts --check",
    "seed": "pnpm --filter strapi seed",
    "export": "pnpm --filter strapi export",
    "check:format": "prettier . --check --cache",
    "fix:format": "prettier . --write --cache",
    "fix": "pnpm fix:format",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^8.2.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.5.3",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^5.0.0",
    "uuid": "^13.0.0",
    "wait-on": "^8.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write --cache"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs,mts}": [
      "eslint -c ./eslint.config.mjs --fix --max-warnings=-1"
    ]
  },
  "packageManager": "pnpm@10.28.1"
}
