# Copy to .env.local. No values here — this file is committed.
# Every variable is parsed in src/global/lib/env.ts at module load, so a
# malformed value fails the build rather than a request at 3am.

# --- Content -------------------------------------------------------------
# local (default) reads src/features/work/data/work.json and needs no back
# end. strapi requires both variables below. See cms/README.md.
CONTENT_SOURCE=local
STRAPI_URL=
STRAPI_API_TOKEN=

# --- Site ----------------------------------------------------------------
# Unset, every CTA links to the work instead of opening a mailto. That is
# the intended local behaviour; it is set in Vercel.
NEXT_PUBLIC_CONTACT_EMAIL=
# Canonical tags and the sitemap. Defaults to the production URL when unset.
NEXT_PUBLIC_SITE_URL=https://adudev.co.uk

# --- Auth (not built yet — see docs/playbooks/auth.md) -------------------
# Better Auth runs inside this app against a database you own. These two
# are what sessions actually need.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Its own database, never Strapi's schema: Strapi migrates that one.
AUTH_DATABASE_URL=

# Optional and additive: the key from a Better Auth Infrastructure project,
# for the dash() plugin (analytics, activity, admin APIs). Sign-in works
# without it. Add it last, so a break tells you which half broke.
BETTER_AUTH_API_KEY=
