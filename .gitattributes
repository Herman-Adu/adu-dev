# Normalize all text files to LF in the repo AND the working tree.
# Prettier is configured with endOfLine: lf; without this, core.autocrlf=true
# checkouts produce CRLF working copies that fail pnpm check:format en masse.
* text=auto eol=lf

# Binary assets - never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.tar.gz binary
*.db binary
